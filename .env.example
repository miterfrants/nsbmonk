# ── 必填 ──────────────────────────────────────────────
# OpenAI(Whisper 語音辨識 + GPT 解析)
OPENAI_API_KEY=sk-...

# Google 試算表:網址 https://docs.google.com/spreadsheets/d/【這段】/edit
SPREADSHEET_ID=

# 登入用 JWT 簽章密鑰(隨機長字串即可,例:openssl rand -hex 32)
JWT_SECRET=

# 允許登入的 email,逗號分隔
ALLOWED_EMAILS=you@example.com

# Brevo(寄 magic link 登入信)https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
SENDER_EMAIL=you@example.com

# ── LINE 現金通知(選填;有設 token 才會啟用)──────────────
# LINE Developers → Messaging API channel → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ── 選填(有預設值)────────────────────────────────────
# PORT=3000
# SHEET_NAME=記帳
# SENDER_NAME=語音記帳
# JWT_TTL_DAYS=30
# APP_URL=http://localhost:3000
# GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
# CASH_RANGE=記帳!F:F   # 現金餘額來源,整欄取最後一個有值的格子,也可指定單格
# PARSE_MODEL=gpt-4o-mini
# WHISPER_MODEL=whisper-1
